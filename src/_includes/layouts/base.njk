<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% set pageTitle = (title + " | " + site.name) if title and page.url != "/" else (site.name + ": " + site.tagline) %}
{% set pageDesc = summary or description or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ siteUrl }}{{ page.url }}">
<meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ siteUrl }}{{ page.url }}">
<meta property="og:image" content="{{ siteUrl }}/assets/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Scholar Fahad: fully funded scholarships, and how to win them">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ siteUrl }}/assets/og-image.png">
<link rel="icon" href="/assets/icon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/style.css">
{% if site.adsense_client %}
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsense_client }}" crossorigin="anonymous"></script>
{% endif %}
{% block head %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/"><span class="seal">SF</span>{{ site.name }}</a>
    <nav class="links" id="nav" aria-label="Main">
      {% set navItems = [["/scholarships/", "Scholarships"], ["/opportunities/", "Browse"], ["/opportunities/internships/", "Internships"], ["/guides/", "Guides"], ["/success-stories/", "Success stories"], ["/services/", "Services"], ["/about/", "About"]] %}
      {% for item in navItems %}
      <a href="{{ item[0] }}"{% if page.url == item[0] or (item[0] != "/opportunities/" and page.url.startsWith(item[0])) %} aria-current="page"{% endif %}>{{ item[1] }}</a>
      {% endfor %}
    </nav>
    <div class="top-right">
      <a class="search-btn" href="/search/" aria-label="Search"{% if page.url == "/search/" %} aria-current="page"{% endif %}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
    </div>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <a class="brand" href="/"><span class="seal">SF</span>{{ site.name }}</a>
        <p class="warn" style="margin-top:14px;max-width:52ch"><b>Stay safe:</b> official government scholarships are free to apply for. Never pay anyone who promises a guaranteed award or asks for an "application fee" on a provider's behalf.</p>
        <p class="social">
          <a href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a>
          {% if site.instagram %}<a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
          {% if site.whatsapp_channel %}<a href="{{ site.whatsapp_channel }}" target="_blank" rel="noopener">WhatsApp channel</a>{% endif %}
          {% if site.youtube %}<a href="{{ site.youtube }}" target="_blank" rel="noopener">YouTube</a>{% endif %}
        </p>
      </div>
      <div>
        <h4>Scholarships</h4>
        <ul>
          <li><a href="/scholarships/">All opportunities</a></li>
          {% for p in collections.browsePages | browse("level") %}{% if p.items.length %}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{% endif %}{% endfor %}
          <li><a href="/scholarships/countries/">By country</a></li>
        </ul>
      </div>
      <div>
        <h4>Opportunities</h4>
        <ul>
          {% for p in collections.browsePages | browse("type") %}{% if p.items.length and p.key != "Scholarship" %}<li><a href="{{ p.url }}">{{ p.label }}</a></li>{% endif %}{% endfor %}
          {% for p in collections.browsePages | browse("audience") %}{% if p.items.length and p.key != "international" %}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{% endif %}{% endfor %}
        </ul>
      </div>
      <div>
        <h4>Help</h4>
        <ul>
          <li><a href="/guides/">Application guides</a></li>
          <li><a href="/success-stories/">Success stories</a></li>
          <li><a href="/services/">Document reviews</a></li>
          <li><a href="/search/">Search</a></li>
        </ul>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/advertise/">Advertise with us</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
        </ul>
      </div>
    </div>
    <p class="copy">© {{ buildDate | year }} {{ site.name }}. Scholarship information is free for everyone.</p>
  </div>
</footer>
<script>
  (function () {
    var b = document.querySelector(".menu-btn"), n = document.getElementById("nav");
    if (b) b.addEventListener("click", function () {
      var o = n.classList.toggle("open"); b.setAttribute("aria-expanded", o ? "true" : "false");
    });
  })();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
