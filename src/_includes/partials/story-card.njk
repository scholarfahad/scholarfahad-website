<a class="story" href="{{ st.url }}">
  {% if st.data.photo %}<img src="{{ st.data.photo }}" alt="{{ st.data.name }}" loading="lazy" width="72" height="72">{% else %}<span class="avatar" aria-hidden="true">{{ st.data.name | first }}</span>{% endif %}
  <div>
    <blockquote>“{{ st.data.quote }}”</blockquote>
    <b>{{ st.data.name }}</b>
    <span>{{ st.data.scholarship }}{% if st.data.university %} · {{ st.data.university }}{% endif %}</span>
  </div>
</a>
