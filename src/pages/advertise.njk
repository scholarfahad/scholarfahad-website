---
layout: layouts/base.njk
title: Advertise with Scholar Fahad
description: Promote your university, programme or education service to students actively applying for scholarships and study abroad.
permalink: /advertise/
---
<div class="wrap">
  <header class="page-head">
    <div class="label">Partnerships</div>
    <h1>Advertise with Scholar Fahad</h1>
    <p>{{ advertise.intro }}</p>
    <div class="ctas"><a class="btn btn-primary" href="#enquire">Send an enquiry</a></div>
  </header>

  <div class="proof" style="margin-top:0;padding-top:0;border-top:0">
    {% for a in advertise.audience %}{% if a.value %}
    <div><b>{{ a.value }}</b><span>{{ a.label }}</span></div>
    {% endif %}{% endfor %}
  </div>

  <section class="block" style="margin-top:40px">
    <div class="sec-head">
      <div><div class="label">Audience</div><h2>Who you'll reach</h2></div>
      <p>People who follow Scholar Fahad are actively preparing applications, so your message reaches them at the moment they're making decisions.</p>
    </div>
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))">
      <div class="card">
        <h3>Our audience</h3>
        <ul style="margin:0;padding-left:18px;display:grid;gap:6px;color:var(--muted)">
          {% for p in advertise.audience_profile %}<li>{{ p }}</li>{% endfor %}
        </ul>
      </div>
      <div class="card">
        <h3>Who advertises with us</h3>
        <ul style="margin:0;padding-left:18px;display:grid;gap:6px;color:var(--muted)">
          {% for w in advertise.who_for %}<li>{{ w }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="sec-head">
      <div><div class="label">Packages</div><h2>Ways to work together</h2></div>
      <p>Every sponsored item is clearly labelled, which keeps our audience's trust and makes your message more credible.</p>
    </div>
    <div class="services">
      {% for s in advertise.packages %}
      <article class="svc">
        <h3>{{ s.name }}</h3>
        <p>{{ s.description }}</p>
        <ul>{% for p in s.includes %}<li>{{ p }}</li>{% endfor %}</ul>
        <div class="price">{{ s.price or "Contact for rates" }}</div>
      </article>
      {% endfor %}
    </div>
    <p class="note">We only promote legitimate programmes and services. We don't accept ads that charge students fees for scholarships or promise guaranteed admission or visas.</p>
  </section>

  <section class="block" id="enquire">
    <div class="sec-head">
      <div><div class="label">Enquiry</div><h2>Tell us about your campaign</h2></div>
      <p>We usually reply within two working days with availability and rates.</p>
    </div>
    <form class="form" name="advertise" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company">
      <input type="hidden" name="form-name" value="advertise">
      <p class="hidden"><label>Leave this empty <input name="company"></label></p>
      <div class="two">
        <label for="a-name">Your name<input id="a-name" name="name" required autocomplete="name"></label>
        <label for="a-org">Organisation<input id="a-org" name="organisation" required autocomplete="organization"></label>
      </div>
      <div class="two">
        <label for="a-email">Work email<input id="a-email" type="email" name="email" required autocomplete="email"></label>
        <label for="a-pkg">Interested in
          <select id="a-pkg" name="package">
            {% for s in advertise.packages %}<option>{{ s.name }}</option>{% endfor %}
            <option>Not sure yet</option>
          </select>
        </label>
      </div>
      <div class="two">
        <label for="a-site">Website<input id="a-site" type="url" name="website" placeholder="https://"></label>
        <label for="a-date">Preferred start date<input id="a-date" type="date" name="start_date"></label>
      </div>
      <label for="a-msg">About your campaign<textarea id="a-msg" name="message" placeholder="What are you promoting, and is there a deadline?" required></textarea></label>
      <div><button class="btn btn-primary" type="submit">Send enquiry</button></div>
    </form>
  </section>
</div>
